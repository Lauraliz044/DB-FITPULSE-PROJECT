{
  "name": "fitpulse-api",
  "version": "1.0.0",
  "private": true,
  "description": "FitPulse classroom API with English SQL and basic JavaScript functions",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
