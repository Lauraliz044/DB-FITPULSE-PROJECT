PORT=5000
API_PREFIX=/api/v1
BASE_URL=http://localhost:5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitpulse_project
DB_USER=root
DB_PASSWORD=replace_with_your_database_password
DB_CONNECTION_LIMIT=10
MAX_BODY_SIZE=100kb
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
BUSINESS_TIME_ZONE=America/Bogota
ADMIN_NAME=FitPulse Administrator
ADMIN_EMAIL=admin@fitpulse.example
ADMIN_PASSWORD=replace_with_your_demo_password
DEMO_CLIENT_NAME=FitPulse Demo Client
DEMO_CLIENT_EMAIL=client@fitpulse.example
DEMO_CLIENT_PASSWORD=replace_with_another_demo_password
TEST_DB_NAME=fitpulse_project_test
