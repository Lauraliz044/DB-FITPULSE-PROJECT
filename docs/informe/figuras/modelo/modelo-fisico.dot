digraph Model {
graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.5", ranksep="0.8", splines=polyline];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#596b7a", fontname="DejaVu Sans", fontsize=9];
"packages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#96acb7"><TR><TD COLSPAN="3" BGCOLOR="#173f50"><FONT COLOR="white"><B>packages</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idpackages">idpackages</TD><TD ALIGN="LEFT">int</TD><TD>PK AI</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">varchar(45)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="price">price</TD><TD ALIGN="LEFT">decimal(10,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="class_quantity">class_quantity</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR></TABLE>>];
"personal_records" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#96acb7"><TR><TD COLSPAN="3" BGCOLOR="#173f50"><FONT COLOR="white"><B>personal_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idrecord">idrecord</TD><TD ALIGN="LEFT">int</TD><TD>PK AI</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="exercise">exercise</TD><TD ALIGN="LEFT">varchar(120)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="record_type">record_type</TD><TD ALIGN="LEFT">varchar(45)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="value">value</TD><TD ALIGN="LEFT">decimal(12,3)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="unit">unit</TD><TD ALIGN="LEFT">varchar(45)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="achieved_on">achieved_on</TD><TD ALIGN="LEFT">date</TD><TD></TD></TR></TABLE>>];
"purchases" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#96acb7"><TR><TD COLSPAN="3" BGCOLOR="#173f50"><FONT COLOR="white"><B>purchases</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idpurchase">idpurchase</TD><TD ALIGN="LEFT">int</TD><TD>PK AI</TD></TR><TR><TD ALIGN="LEFT" PORT="paid_price">paid_price</TD><TD ALIGN="LEFT">decimal(10,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="purchased_at">purchased_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="idusers">idusers</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="idpackages">idpackages</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR></TABLE>>];
"reservations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#96acb7"><TR><TD COLSPAN="3" BGCOLOR="#173f50"><FONT COLOR="white"><B>reservations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idreservation">idreservation</TD><TD ALIGN="LEFT">int</TD><TD>PK AI</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="class_id">class_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT">varchar(10)</TD><TD></TD></TR></TABLE>>];
"reviews" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#96acb7"><TR><TD COLSPAN="3" BGCOLOR="#173f50"><FONT COLOR="white"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idreview">idreview</TD><TD ALIGN="LEFT">int</TD><TD>PK AI</TD></TR><TR><TD ALIGN="LEFT" PORT="rating">rating</TD><TD ALIGN="LEFT">tinyint</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="comment">comment</TD><TD ALIGN="LEFT">text NULL</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="tags">tags</TD><TD ALIGN="LEFT">json</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="iduser">iduser</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="idclass">idclass</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="intensity">intensity</TD><TD ALIGN="LEFT">varchar(10) NULL</TD><TD></TD></TR></TABLE>>];
"scheduled_classes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#96acb7"><TR><TD COLSPAN="3" BGCOLOR="#173f50"><FONT COLOR="white"><B>scheduled_classes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idscheduled_classes">idscheduled_classes</TD><TD ALIGN="LEFT">int</TD><TD>PK AI</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">varchar(45)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="instructor_name">instructor_name</TD><TD ALIGN="LEFT">varchar(45)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT">varchar(45)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="price">price</TD><TD ALIGN="LEFT">decimal(10,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="capacity">capacity</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#96acb7"><TR><TD COLSPAN="3" BGCOLOR="#173f50"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idusers">idusers</TD><TD ALIGN="LEFT">int</TD><TD>PK AI</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">varchar(45)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT">varchar(254)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="password">password</TD><TD ALIGN="LEFT">varchar(255)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT">varchar(10)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT">varchar(10)</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at">registered_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="failed_login_attempts">failed_login_attempts</TD><TD ALIGN="LEFT">int unsigned</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_until">locked_until</TD><TD ALIGN="LEFT">datetime NULL</TD><TD></TD></TR></TABLE>>];
"users":idusers -> "personal_records":user_id [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed];
"packages":idpackages -> "purchases":idpackages [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed];
"users":idusers -> "purchases":idusers [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed];
"scheduled_classes":idscheduled_classes -> "reservations":class_id [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed];
"users":idusers -> "reservations":user_id [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed];
"scheduled_classes":idscheduled_classes -> "reviews":idclass [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed];
"users":idusers -> "reviews":iduser [dir=both, arrowtail=tee, arrowhead=crowodot, style=dashed];
}